# Collabsight AV CRM - Server Environment Variables

# Backend Port
PORT=5000

# Google Places API Key
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Enable "Places API" (or "Places API (New)")
# 3. Create Credentials -> API Key
# 4. Paste your key below (and rename/copy this file to .env)
GOOGLE_PLACES_API_KEY=
